        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Cargar el archivo\n",
        "df_dataset = pd.read_csv(\"dataset.csv\")\n",
        "\n",
        "# Seleccionar el top 10 canciones más populares\n",
        "top10_tracks = df_dataset.nlargest(10, \"popularity\")[[\"track_name\", \"artists\", \"popularity\"]]\n",
        "\n",
        "# Crear etiquetas con el nombre de la canción y el artista\n",
        "top10_tracks[\"label\"] = top10_tracks[\"track_name\"] + \" - \" + top10_tracks[\"artists\"]\n",
        "\n",
        "# Graficar\n",
        "plt.figure(figsize=(10,6))\n",
        "plt.barh(top10_tracks[\"label\"], top10_tracks[\"popularity\"], color=\"skyblue\", edgecolor=\"black\")\n",
